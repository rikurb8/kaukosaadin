<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Baseline network permission for talking to devices over the home LAN.
        Android 17 (API 37) additionally gates local network access behind the
        ACCESS_LOCAL_NETWORK runtime permission; with targetSdk 36 that is still
        opt-in, so it is requested when device clients are added in GOO-26/GOO-28.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kaukosaadin">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
